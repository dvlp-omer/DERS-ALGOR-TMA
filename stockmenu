float price_calculate(float product, float amount) {
    float price_total = (float)(product * amount);

    total_cart = total_cart + price_total;
    printf("\nProduct Amount = %.2lf TL // Total Cart = %.2lf TL\n", price_total, total_cart);

    return price_total;
}

